{
  "name": "media-flux",
  "productName": "Media Flux",
  "version": "1.0.0",
  "description": "A modern desktop media player built with Electron and React",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "",
    "start": "concurrently \"npx tailwindcss -i ./src/App.css -o ./src/dist/App.css --watch\" \"webpack --config webpack/webpack.config.js --env env=dev --watch\" \"electron .\"",
    "build": "webpack --config webpack/webpack.config.js --env env=prod",
    "launch": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [],
  "author": {
    "name": "Md Ali Akbar",
    "email": "md.aliakbar.dev@gmail.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.18",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.1",
    "css-loader": "^6.10.0",
    "electron": "^28.2.2",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.35",
    "sass": "^1.70.0",
    "sass-loader": "^14.1.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.8",
    "@heroicons/react": "^2.1.1",
    "@mui/icons-material": "^5.15.11",
    "@reduxjs/toolkit": "^2.2.1",
    "@types/react-redux": "^7.1.33",
    "jsmediatags": "^3.9.7",
    "postcss-loader": "^8.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.2",
    "styled-components": "^6.1.8",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.akbar.mediaflux",
    "productName": "Media Flux",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "build/**/*",
      "package.json",
      "node_modules/**/*",
      "ipchandler/**/*",
      "helper.js",
      "preload.js"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Media Flux"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons"
    }
  }
}
